{
  "name": "commander-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-driven MTG Commander deck optimization agent",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:offline": "node scripts/offline-check.mjs",
    "ingest:scryfall": "tsx scripts/ingest-scryfall.ts",
    "validate:manifest": "tsx scripts/validate-sample-manifest.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm validate:manifest"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
